# Modelo para o seu application-local.yml (copie para src/main/resources/application-local.yml).
# O application-local.yml real é ignorado pelo Git; este modelo é versionado e NÃO deve ter segredos.
# Só vale com o perfil ativo: SPRING_PROFILES_ACTIVE=local (na IDE, em Environment variables).
#
# spring:
#   jpa:
#     show-sql: true
# server:
#   port: 8081
# logging:
#   level:
#     br.com.vitor: DEBUG
#
# A senha do banco NÃO vai aqui: use a variável de ambiente DB_PASSWORD.
#
# CORS (só quando um front-end de outro domínio for chamar a API pelo navegador). Lista de origens separadas por
# vírgula, sem barra no fim e NUNCA com '*' (a aplicação não sobe). Pode ser a variável de ambiente
# CORS_ALLOWED_ORIGINS=http://localhost:5173 ou, aqui:
# cors:
#   allowed-origins: http://localhost:5173
