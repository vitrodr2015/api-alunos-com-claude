    {
      "name": "1 - CRUD de alunos",
      "description": "Rode em ordem (Runner): o primeiro item guarda o id em {{alunoId}} e o último remove o aluno.",
      "item": [
        {
          "name": "Criar aluno",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('emailAluno', 'aluno.' + Date.now() + '@escola.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Tem cabeçalho Location', () => pm.response.to.have.header('Location'));",
                  "pm.test('Aluno nasce ativo', () => pm.expect(pm.response.json().ativo).to.eql(true));",
                  "pm.environment.set('alunoId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/alunos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alunos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Aluno de Teste\",\n  \"email\": \"{{emailAluno}}\",\n  \"dataNascimento\": \"2000-01-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Gera um e-mail único a cada execução e guarda o id criado em {{alunoId}}."
          }
        },
        {
          "name": "Listar alunos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Resposta em HAL: _embedded, _links e page', () => pm.expect(pm.response.json()).to.have.all.keys('_embedded', '_links', 'page'));",
                  "pm.test('page traz number, size, totalElements e totalPages', () => pm.expect(pm.response.json().page).to.have.all.keys('number', 'size', 'totalElements', 'totalPages'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/alunos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alunos"
              ]
            }
          }
        },
        {
          "name": "Listar paginado e ordenado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('No máximo 5 itens', () => pm.expect(pm.response.json()._embedded.alunos.length).to.be.at.most(5));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/alunos?page=0&size=5&sort=nome,desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alunos"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "5"
                },
                {
                  "key": "sort",
                  "value": "nome,desc"
                }
              ]
            },
            "description": "Resposta em HAL (_embedded.alunos, _links e page). page começa em 0; size padrão 20 e máximo 50 (acima disso é reduzido); sort aceita qualquer campo do aluno (id, nome, email, dataNascimento, ativo), com ,asc ou ,desc. Campo inexistente dá 400."
          }
        },
        {
          "name": "Listar filtrando por nome",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/alunos?nome=ana",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alunos"
              ],
              "query": [
                {
                  "key": "nome",
                  "value": "ana"
                }
              ]
            }
          }
        },
        {
          "name": "Listar só ativos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Todos ativos', () => pm.response.json()._embedded.alunos.forEach(a => pm.expect(a.ativo).to.eql(true)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/alunos?ativo=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alunos"
              ],
              "query": [
                {
                  "key": "ativo",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Listar só inativos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Todos inativos', () => pm.response.json()._embedded.alunos.forEach(a => pm.expect(a.ativo).to.eql(false)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/alunos?ativo=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alunos"
              ],
              "query": [
                {
                  "key": "ativo",
                  "value": "false"
                }
              ]
            }
          }
        },
        {
          "name": "Buscar por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('É o aluno pedido', () => pm.expect(pm.response.json().id).to.eql(Number(pm.environment.get('alunoId'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/alunos/{{alunoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alunos",
                "{{alunoId}}"
              ]
            }
          }
        },
        {
          "name": "Atualizar aluno (PUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Nome atualizado', () => pm.expect(pm.response.json().nome).to.eql('Aluno de Teste Atualizado'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/alunos/{{alunoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alunos",
                "{{alunoId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Aluno de Teste Atualizado\",\n  \"email\": \"{{emailAluno}}\",\n  \"dataNascimento\": \"2000-01-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Substitui nome, e-mail e data de nascimento. Não altera o campo ativo."
          }
        },
        {
          "name": "Desativar aluno",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('ativo=false', () => pm.expect(pm.response.json().ativo).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/alunos/{{alunoId}}/disable",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alunos",
                "{{alunoId}}",
                "disable"
              ]
            },
            "description": "Idempotente: repetir não dá erro."
          }
        },
        {
          "name": "Reativar aluno",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('ativo=true', () => pm.expect(pm.response.json().ativo).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/alunos/{{alunoId}}/enable",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alunos",
                "{{alunoId}}",
                "enable"
              ]
            },
            "description": "Idempotente: repetir não dá erro."
          }
        },
        {
          "name": "Remover aluno",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));",
                  "pm.test('Sem corpo', () => pm.expect(pm.response.text()).to.eql(''));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/alunos/{{alunoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alunos",
                "{{alunoId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2 - Erros esperados",
      "description": "Cada item deve devolver o erro indicado no nome, no formato ErrorResponse.",
      "item": [
        {
          "name": "Preparação: criar aluno para o teste de conflito",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = 'conflito.' + Date.now() + '@escola.com';",
                  "pm.environment.set('emailConflito', email);",
                  "pm.environment.set('emailConflitoMaiusculo', email.toUpperCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/alunos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alunos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Aluno Conflito\",\n  \"email\": \"{{emailConflito}}\",\n  \"dataNascimento\": \"1999-09-09\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Rode antes do item \"E-mail repetido\"."
          }
        },
        {
          "name": "400 - POST com corpo vazio",
          "event": [
            {
              "listen": "test",
              "script": {
